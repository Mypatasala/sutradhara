# LLM Configuration
# LLM_PROVIDER controls which back-end is active: openai | google | ollama | auto
# 'auto' tries all providers with valid credentials in order: OpenAI → Google → Ollama
LLM_PROVIDER=auto

# When only one provider is active, LLM_MODEL sets the model name.
# For independent control in auto mode use the provider-specific vars below.
LLM_MODEL=

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-flash-latest

# Ollama (local) — install langchain-ollama, then run: ollama pull llama3.2
# Set LLM_PROVIDER=ollama (or leave auto and set OLLAMA_BASE_URL) to activate.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database
# DB_PATH: used only when DATABASE_URL is unset (the bundled SQLite demo).
DB_PATH=school.db
# DATABASE_URL: set to a SQLAlchemy MariaDB URL to query a real tenant's DB
# instead of the SQLite demo (used for the myPatasala integration). Always
# use a read-only DB user here — see docker/mariadb-init/ in my_patasala
# and docs/architecture/Sutradhara-Ask-Integration-Status.md.
# Example: DATABASE_URL=mysql+pymysql://sutradhara_ro:sutradhara_ro_pass@localhost:3306/mypatasala
DATABASE_URL=
MAX_QUERY_RESULTS=1000
DB_STATEMENT_TIMEOUT_SECONDS=5

# Policy Engine
OPA_URL=http://localhost:8181/v1/data/sutradhara/main/decision
# OPA_TENANT: which tenant's policy bundle (under EXTRA_POLICY_PATH) to
# dispatch into by default — set to "patasala" for a myPatasala-dedicated
# sutradhara instance. Leave unset to use the bundled ./roles/ demo policies.
OPA_TENANT=
# EXTRA_POLICY_PATH: extra OPA bundle root(s), e.g. a path to
# my_patasala/policy/opa/ — see run.sh/entrypoint.sh.
EXTRA_POLICY_PATH=

# API auth
API_TOKEN_SECRET=your_random_secret_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Static API tokens for service accounts / local dev
# Format: token:role:user_id[:department_id[:linked_student_id]], comma-separated
# A token with role "service" is a trusted backend (e.g. myPatasala's
# AskController) calling on behalf of an end user it has already
# authenticated itself — its caller-supplied `context` is trusted verbatim
# rather than overridden (see gateway/main.py). Generate a real secret for
# it, don't reuse this placeholder.
STATIC_TOKENS=dev-admin-key:admin:admin_01:1,dev-teacher-key:teacher:teacher_01,dev-student-key:student:1,dev-parent-key:parent:parent_01::1,your_service_secret_here:service:mypatasala_backend
